# Rutas del sitio anterior (Google Sites) hacia las rutas nuevas.
# Cloudflare Pages y Workers Static Assets aplican estos 301 antes de servir los archivos.
#
# El formato no conserva el query string. La documentación marca "Query Parameters"
# como no soportado: no hay placeholder para url.search ni para los UTM.
# https://developers.cloudflare.com/workers/static-assets/redirects/
#
# Para no perder la campaña hace falta un Worker (no está en este repositorio y no se despliega aquí)
# que responda 301 y copie la búsqueda:
#   const destino = { "/erpa": "/residencia-puertas-abiertas", "/erep": "/estabilizacion", "/inicio": "/" };
#   const ruta = url.pathname.replace(/\/$/, "") || "/";
#   if (destino[ruta]) return Response.redirect(new URL(destino[ruta] + url.search, url), 301);
/inicio                      /                              301
/inicio/                     /                              301
/erpa                        /residencia-puertas-abiertas   301
/erpa/                       /residencia-puertas-abiertas   301
/erep                        /estabilizacion                301
/erep/                       /estabilizacion                301
