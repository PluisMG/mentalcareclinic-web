# Medición de visitas. Déjelo vacío: sin este valor no hay aviso ni se carga Google.
# Forma esperada: G-XXXXXXXX. No escriba un ID real en el repositorio.
PUBLIC_GA4_ID=

# URL canónica (AP-2026-11-26-10). No es un secreto: el CI la pone en claro.
# En local, si esta variable no llega al proceso, el build usa http://127.0.0.1:43123.
# Con VERCEL_ENV=production el build sale con error si falta.
PUBLIC_SITE_URL=https://app.mentalcareclinic.com

# Indexación apagada. Vacío: noindex y Disallow: /.
# Solo PUBLIC_INDEXAR=1 junto con VERCEL_ENV=production permite indexar, y eso pide una AP de Pedro.
PUBLIC_INDEXAR=
