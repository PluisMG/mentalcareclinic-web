---
interface Item {
  q: string;
  a: string;
}
interface Props {
  title?: string;
  items: readonly Item[];
}
const { title = "Preguntas frecuentes", items } = Astro.props;
---
<section class="block">
  <h2>{title}</h2>
  <div class="faq">
    {
      items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))
    }
  </div>
</section>
